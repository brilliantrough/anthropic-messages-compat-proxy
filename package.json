{
  "name": "anthropic-messages-compat-proxy",
  "version": "0.1.0",
  "description": "Compatibility proxy for Anthropic Messages API providers with SSE passthrough, model aliases, and local runtime tooling.",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/brilliantrough/anthropic-messages-compat-proxy.git"
  },
  "homepage": "https://github.com/brilliantrough/anthropic-messages-compat-proxy#readme",
  "bugs": {
    "url": "https://github.com/brilliantrough/anthropic-messages-compat-proxy/issues"
  },
  "keywords": [
    "anthropic",
    "claude",
    "messages-api",
    "api-proxy",
    "sse",
    "streaming",
    "typescript",
    "compatibility",
    "fallback",
    "admin-ui"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check:anthropic-input": "tsx checks/check-anthropic-input-normalization.ts",
    "check:anthropic-sse": "tsx checks/check-anthropic-sse.ts",
    "check:anthropic-sse-parity": "tsx checks/check-anthropic-sse-parity.ts",
    "check:anthropic-proxy-basic": "tsx checks/check-anthropic-proxy-basic.ts",
    "check:anthropic-concurrency-guard": "tsx checks/check-anthropic-concurrency-guard.ts",
    "check": "npm run check:anthropic-input && npm run check:anthropic-sse && npm run check:anthropic-sse-parity && npm run check:anthropic-proxy-basic && npm run check:anthropic-logging && npm run check:anthropic-config && npm run check:anthropic-nonstream-fallback && npm run check:anthropic-nonstream-invalid-json-fallback && npm run check:anthropic-nonstream-missing-usage-fallback && npm run check:anthropic-nonstream-body-timeout-fallback && npm run check:anthropic-nonstream-sse-logging && npm run check:anthropic-nonstream-sse-timeout-logging && npm run check:anthropic-stream-fallback && npm run check:anthropic-stream-timeout-fallback && npm run check:anthropic-stream-unhandled-error-parity && npm run check:anthropic-cooldown && npm run check:anthropic-admin-config-api && npm run check:anthropic-admin-monitor && npm run check:anthropic-runtime-reload && npm run check:anthropic-docs-smoke && npm run check:anthropic-stream-progressive && npm run check:anthropic-stream-mode && npm run check:anthropic-stream-commit-gate && npm run check:anthropic-stats && npm run check:anthropic-models-timeout && npm run check:anthropic-models-idle-timeout && npm run check:anthropic-nonstream-timeouts && npm run check:anthropic-fallback-policy && npm run check:anthropic-unhandled-error-parity && npm run check:anthropic-concurrency-guard",
    "proxy": "tsx src/anthropic-proxy.ts",
    "proxy:dev": "tsx src/anthropic-proxy.ts",
    "proxy:start": "node dist/anthropic-proxy.js",
    "check:anthropic-docs-smoke": "tsx checks/check-anthropic-docs-smoke.ts",
    "check:anthropic-config": "tsx checks/check-anthropic-config.ts",
    "check:anthropic-logging": "tsx checks/check-anthropic-logging.ts",
    "check:anthropic-nonstream-fallback": "tsx checks/check-anthropic-nonstream-fallback.ts",
    "check:anthropic-nonstream-invalid-json-fallback": "tsx checks/check-anthropic-nonstream-invalid-json-fallback.ts",
    "check:anthropic-nonstream-missing-usage-fallback": "tsx checks/check-anthropic-nonstream-missing-usage-fallback.ts",
    "check:anthropic-nonstream-body-timeout-fallback": "tsx checks/check-anthropic-nonstream-body-timeout-fallback.ts",
    "check:anthropic-nonstream-sse-logging": "tsx checks/check-anthropic-nonstream-sse-logging.ts",
    "check:anthropic-nonstream-sse-timeout-logging": "tsx checks/check-anthropic-nonstream-sse-timeout-logging.ts",
    "check:anthropic-stream-fallback": "tsx checks/check-anthropic-stream-fallback.ts",
    "check:anthropic-stream-timeout-fallback": "tsx checks/check-anthropic-stream-timeout-fallback.ts",
    "check:anthropic-cooldown": "tsx checks/check-anthropic-cooldown.ts",
    "check:anthropic-admin-config-api": "tsx checks/check-anthropic-admin-config-api.ts",
    "check:anthropic-admin-monitor": "tsx checks/check-anthropic-admin-monitor.ts",
    "check:anthropic-runtime-reload": "tsx checks/check-anthropic-runtime-reload.ts",
    "check:anthropic-stream-progressive": "tsx checks/check-anthropic-stream-progressive.ts",
    "check:anthropic-stream-mode": "tsx checks/check-anthropic-stream-mode.ts",
    "check:anthropic-stream-commit-gate": "tsx checks/check-anthropic-stream-commit-gate.ts",
    "check:anthropic-stats": "tsx checks/check-anthropic-stats.ts",
    "check:anthropic-models-timeout": "tsx checks/check-anthropic-models-timeout.ts",
    "check:anthropic-models-idle-timeout": "tsx checks/check-anthropic-models-idle-timeout.ts",
    "check:anthropic-nonstream-timeouts": "tsx checks/check-anthropic-nonstream-timeouts.ts",
    "check:anthropic-fallback-policy": "tsx checks/check-anthropic-fallback-policy.ts",
    "check:anthropic-unhandled-error-parity": "tsx checks/check-anthropic-unhandled-error-parity.ts",
    "check:anthropic-stream-unhandled-error-parity": "tsx checks/check-anthropic-stream-unhandled-error-parity.ts"
  },
  "dependencies": {
    "undici": "^7.15.0",
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  }
}
